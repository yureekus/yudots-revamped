#!/usr/bin/env bash

set -euo pipefail

service="net.hadess.PowerProfiles"
object_path="/net/hadess/PowerProfiles"
interface="net.hadess.PowerProfiles"
property="ActiveProfile"
signal_number="2"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_dir="$runtime_dir/yudots-waybar-mode.lock"

default_profiles=(balanced power-saver performance)

have() {
    command -v "$1" >/dev/null 2>&1
}

notify_waybar() {
    pkill -RTMIN+"$signal_number" waybar >/dev/null 2>&1 || true
}

get_profile() {
    local profile=""

    if have powerprofilesctl; then
        if profile="$(powerprofilesctl get 2>/dev/null)" && [[ -n "$profile" ]]; then
            printf '%s\n' "$profile"
            return 0
        fi
    fi

    if have busctl; then
        profile="$(
            busctl get-property --system "$service" "$object_path" "$interface" "$property" 2>/dev/null |
                sed -E 's/^s "(.*)"$/\1/'
        )"
        if [[ -n "$profile" ]]; then
            printf '%s\n' "$profile"
            return 0
        fi
    fi

    if have gdbus; then
        profile="$(
            gdbus call --system \
                --dest "$service" \
                --object-path "$object_path" \
                --method org.freedesktop.DBus.Properties.Get \
                "$interface" \
                "$property" 2>/dev/null |
                sed -E "s/^\(<'(.*)'>,\)$/\1/"
        )"
        if [[ -n "$profile" ]]; then
            printf '%s\n' "$profile"
            return 0
        fi
    fi

    return 1
}

set_profile() {
    local profile="$1"

    if have powerprofilesctl && powerprofilesctl set "$profile" >/dev/null 2>&1; then
        return 0
    fi

    if have busctl && busctl set-property --system "$service" "$object_path" "$interface" "$property" s "$profile" >/dev/null 2>&1; then
        return 0
    fi

    if have gdbus && gdbus call --system \
            --dest "$service" \
            --object-path "$object_path" \
            --method org.freedesktop.DBus.Properties.Set \
            "$interface" \
            "$property" \
            "<'$profile'>" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

list_profiles() {
    local line=""
    local parsed=""
    local found_any="0"

    if have powerprofilesctl; then
        while IFS= read -r line; do
            parsed="$(printf '%s\n' "$line" | sed -nE 's/^\*?[[:space:]]*(power-saver|balanced|performance):.*$/\1/p')"
            if [[ -n "$parsed" ]]; then
                printf '%s\n' "$parsed"
                found_any="1"
            fi
        done < <(powerprofilesctl list 2>/dev/null || true)

        if [[ "$found_any" == "1" ]]; then
            return 0
        fi
    fi

    printf '%s\n' "${default_profiles[@]}"
}

profile_available() {
    local profile="$1"
    local p=""

    while IFS= read -r p; do
        if [[ "$p" == "$profile" ]]; then
            return 0
        fi
    done < <(list_profiles)

    return 1
}

next_candidates() {
    local current="$1"

    case "$current" in
        balanced)
            printf '%s\n' performance power-saver balanced
            ;;
        power-saver)
            printf '%s\n' balanced performance power-saver
            ;;
        performance)
            printf '%s\n' power-saver balanced performance
            ;;
        *)
            printf '%s\n' balanced power-saver performance
            ;;
    esac
}

await_profile() {
    local expected="$1"
    local current=""
    local i=""

    for i in $(seq 1 25); do
        current="$(get_profile 2>/dev/null || true)"
        if [[ "$current" == "$expected" ]]; then
            return 0
        fi
        sleep 0.04
    done

    return 1
}

profile_meta() {
    case "$1" in
        power-saver)
            printf '%s\n%s\n%s\n' "󰁹" "Power Saver" "power-saver"
            ;;
        balanced)
            printf '%s\n%s\n%s\n' "󰗑" "Balanced" "balanced"
            ;;
        performance)
            printf '%s\n%s\n%s\n' "󰓅" "Performance" "performance"
            ;;
        *)
            printf '%s\n%s\n%s\n' "󰧑" "Unknown" "unknown"
            ;;
    esac
}

print_module() {
    local profile=""
    local icon=""
    local label=""
    local class=""
    local -a meta=()

    profile="$(get_profile 2>/dev/null || true)"
    if [[ -z "$profile" ]]; then
        printf '{ "text": "󰧑", "alt": "unavailable", "class": "unknown", "tooltip": "power-profiles-daemon unavailable" }\n'
        return 0
    fi

    mapfile -t meta < <(profile_meta "$profile")
    icon="${meta[0]}"
    label="${meta[1]}"
    class="${meta[2]}"

    printf '{ "text": "%s", "alt": "%s", "class": "%s", "tooltip": "%s" }\n' "$icon" "$class" "$class" "$label"
}

toggle_profile() {
    local current=""
    local target=""

    current="$(get_profile 2>/dev/null || true)"

    for target in $(next_candidates "$current"); do
        set_profile "$target" || continue
        if await_profile "$target"; then
            notify_waybar
            return 0
        fi
    done

    notify_waybar
    return 1
}

with_lock() {
    if ! mkdir "$lock_dir" 2>/dev/null; then
        return 1
    fi

    trap 'rmdir "$lock_dir" >/dev/null 2>&1 || true' EXIT
    "$@"
}

case "${1:-module}" in
    module)
        print_module
        ;;
    toggle)
        with_lock toggle_profile >/dev/null 2>&1 || true
        ;;
    get)
        get_profile
        ;;
    *)
        printf 'usage: %s [module|toggle|get]\n' "$0" >&2
        exit 1
        ;;
esac
