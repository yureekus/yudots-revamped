#!/usr/bin/env bash
#
# Apply NixOS system updates.
# Passing "module" returns the update status in JSON format.
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 16, 2025
# License: MIT

DEFAULT_FLAKE_PATH="${YUDOTS_FLAKE_PATH:-/etc/nixos}"
DEFAULT_HOST="${YUDOTS_HOSTNAME:-$(hostname)}"

printf() {
	command printf "$@" >&2
}

nixos_flake_target() {
	printf '%s#%s' "$DEFAULT_FLAKE_PATH" "$DEFAULT_HOST"
}

check_updates() {
	READY=false

	if [[ -f "$DEFAULT_FLAKE_PATH/flake.nix" ]]; then
		READY=true
	fi
}

update_packages() {
	if [[ "$READY" != true ]]; then
		notify-send "NixOS Update" "Set YUDOTS_FLAKE_PATH or keep your system flake in /etc/nixos"
		printf "Unable to find a flake at %s/flake.nix.\n" "$DEFAULT_FLAKE_PATH"
		printf "Set YUDOTS_FLAKE_PATH and optionally YUDOTS_HOSTNAME, then rerun.\n"
		read -rsn 1 -p "Press any key to exit..."
		return 0
	fi

	printf "Applying NixOS update from %s\n" "$(nixos_flake_target)"
	sudo nixos-rebuild switch --flake "$(nixos_flake_target)"

	notify-send "Update Complete" -i "package-install"

	printf "\nUpdate Complete!\n"
	read -rsn 1 -p "Press any key to exit..."
}

display_module() {
	local icon tooltip

	if $FAILED; then
		icon='󰒑'
		tooltip="<b>Failed to apply updates</b>\nRight-click to retry"
	elif [[ "$READY" != true ]]; then
		icon='󰸟'
		tooltip="Set YUDOTS_FLAKE_PATH or keep the system flake in /etc/nixos"
	else
		icon='󱄅'
		tooltip="Run nixos-rebuild switch for $(nixos_flake_target)"
	fi

	command printf '{ "text": "%s", "tooltip": "%s" }\n' "$icon" "$tooltip"
}

main() {
	FAILED=false

	case $1 in
		module)
			check_updates
			display_module
			;;
		*)
			printf "Checking NixOS update configuration...\n"
			check_updates
			update_packages
			pkill -RTMIN+1 waybar # Refresh the module
			;;
	esac
}

main "$@"
