{
	"group/tray": {
		"orientation": "horizontal",
		"modules": [
			"custom/tray-toggle",
			"tray"
		],
		"drawer": {
			// "transition-duration":
			"transition-left-to-right": false
			// "children-class":
			// "click-to-reveal":
		}
	},

	"custom/tray-toggle": {
		"format": ">"
	},

	"tray": {
		"icon-size": 16,
		// "show-passive-items":
		// "smooth-scrolling-threshold":
		"spacing": 12,
		// "reverse-direction":
		// "on-update":
		// "expand":
		// "icons":
		"cursor": true,
		"tooltip": false
	}
}
