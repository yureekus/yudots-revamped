// Personal overrides layered on top of the shared defaults.
include "custom/general.kdl"
include "custom/layout.kdl"
include "custom/rules.kdl"
include "custom/binds.kdl"
include "custom/autostart.kdl"

// Generated theme stays last so colors win over static defaults.
include "theme.kdl"
