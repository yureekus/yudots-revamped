#!/usr/bin/env bash

set -euo pipefail

# Applies wallpaper-driven theming via Matugen-managed template hooks.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/matugen"
state_file="$state_dir/current_wallpaper"
overview_blur_file="$state_dir/overview-blur.png"
skip_theme_reapply_once="$state_dir/skip_theme_reapply_once"

usage() {
    echo "Usage:"
    echo "  $0 set <image> [additional awww img args...]"
    echo "  $0 reapply"
}

apply_gtk_defaults() {
    if ! command -v gsettings >/dev/null 2>&1; then
        return 0
    fi

    gsettings set org.gnome.desktop.interface color-scheme prefer-dark >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface font-name "FiraCode Nerd Font 11" >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface monospace-font-name "FiraCode Nerd Font Mono 11" >/dev/null 2>&1 || true
}

apply_theme() {
    local image="$1"

    matugen image "$image" --source-color-index 0
}

build_overview_blur() {
    local image="$1"

    mkdir -p "$state_dir"
    ffmpeg -y -loglevel error -i "$image" -frames:v 1 -vf "gblur=sigma=30,colorchannelmixer=rr=0.45:gg=0.45:bb=0.45" "$overview_blur_file"
}

start_awww_daemon_if_needed() {
    local namespace="$1"

    if [[ -n "$namespace" ]]; then
        if awww query --namespace "$namespace" >/dev/null 2>&1; then
            return 0
        fi

        awww-daemon --namespace "$namespace" >/dev/null 2>&1 &

        for _ in {1..20}; do
            if awww query --namespace "$namespace" >/dev/null 2>&1; then
                return 0
            fi
            sleep 0.1
        done

        echo "Failed to start awww-daemon namespace: $namespace" >&2
        exit 1
    fi

    if awww query >/dev/null 2>&1; then
        return 0
    fi

    awww-daemon >/dev/null 2>&1 &

    for _ in {1..20}; do
        if awww query >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
    done

    echo "Failed to start default awww-daemon" >&2
    exit 1
}

ensure_awww_daemons() {
    start_awww_daemon_if_needed ""
    start_awww_daemon_if_needed "overview"
}

set_wallpaper() {
    local image="$1"
    shift

    mkdir -p "$state_dir"
    printf '%s\n' "$image" > "$state_file"
    rm -f "$skip_theme_reapply_once"

    ensure_awww_daemons
    build_overview_blur "$image"
    awww img "$image" --transition-type none "$@"
    awww img --namespace overview "$overview_blur_file" --transition-type none "$@"
    apply_theme "$image"
}

reapply() {
    apply_gtk_defaults

    if [[ ! -f "$state_file" ]]; then
        exit 0
    fi

    local image
    image="$(<"$state_file")"

    if [[ ! -f "$image" ]]; then
        echo "Saved wallpaper not found: $image" >&2
        exit 1
    fi

    ensure_awww_daemons
    build_overview_blur "$image"

    if [[ -f "$skip_theme_reapply_once" ]]; then
        rm -f "$skip_theme_reapply_once"
        awww img "$image" --transition-type none
        awww img --namespace overview "$overview_blur_file" --transition-type none
        exit 0
    fi

    awww img "$image" --transition-type none
    awww img --namespace overview "$overview_blur_file" --transition-type none
    apply_theme "$image"
}

if ! command -v awww >/dev/null 2>&1; then
    echo "Missing required command: awww" >&2
    exit 1
fi

if ! command -v matugen >/dev/null 2>&1; then
    echo "Missing required command: matugen" >&2
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Missing required command: ffmpeg" >&2
    exit 1
fi

case "${1:-}" in
    set)
        if [[ $# -lt 2 ]]; then
            usage >&2
            exit 1
        fi
        shift
        set_wallpaper "$@"
        ;;
    reapply)
        reapply
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
